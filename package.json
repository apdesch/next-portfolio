{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env.local scripts/seed-placeholders.ts",
    "admin:create": "node --env-file=.env.local scripts/create-admin-user.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "better-auth": "^1.7.26",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.46.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.16.1"
}
